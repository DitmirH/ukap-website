.events-page {
  min-height: 100vh;
  background: var(--color-bg);
}

.events-hero {
  background: linear-gradient(135deg, var(--color-surface-2) 0%, var(--color-border) 100%);
  padding: 6rem 2rem 4rem;
  text-align: center;
}

.events-hero h1 {
  font-family: var(--font-sans);
  font-size: 3rem;
  font-weight: 700;
  font-style: normal;
  color: var(--ukap-yellow-light);
  margin: 0 0 0.5rem;
}

.events-hero p {
  color: var(--color-text-subtle);
  font-size: 1.1rem;
  max-width: 500px;
  margin: 0 auto;
}

.events-page-container {
  max-width: 1100px;
  margin: 0 auto;
  padding: 3rem 2rem 5rem;
}

@media (max-width: 768px) {
  .events-hero {
    padding: 5rem 1.5rem 3rem;
  }
  
  .events-hero h1 {
    font-size: 2.25rem;
  }
  
  .events-page-container {
    padding: 2rem 1rem 4rem;
  }
}

